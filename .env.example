# Core app
APP_NAME=AdaptiveDocAI
ENVIRONMENT=development
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL=postgresql://trustrag:trustrag@localhost:5432/trustrag
POSTGRES_DB=trustrag
POSTGRES_USER=trustrag
POSTGRES_PASSWORD=trustrag

# Vector store
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=adaptive_docai_chunks

# LLM / embeddings
LLM_PROVIDER=fallback
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_TEMPERATURE=0.0
OPENAI_API_KEY=
GEMINI_API_KEY=
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
EMBEDDING_BATCH_SIZE=32
TEMPERATURE=0.2

# Retrieval
TOP_K=8
RERANK_TOP_K=5
BM25_WEIGHT=0.4
DENSE_WEIGHT=0.6
HYBRID_STRATEGY=rrf

# File storage
UPLOAD_DIR=./storage/documents
MAX_FILE_SIZE_MB=20
ALLOWED_EXTENSIONS=.pdf,.docx,.txt

# Redis / cache
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=INFO

# Project
RESEARCH_NAME=Adaptive Explainable Multi-Agent Retrieval-Augmented Framework for Intelligent Document Analysis

# Optional feature toggles
USE_SENTENCE_TRANSFORMERS=true
USE_CROSS_ENCODER=true
ENABLE_STREAMING=false
